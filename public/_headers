# Netlify Headers Configuration for Reliable Offline PWA

# 1. Service Worker: NEVER cache in browser/CDN HTTP cache so updates are always fresh
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# 2. Web Manifests
/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate

/manifest.json
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate

# 3. Dynamic Version Metadata
/version.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate

# 4. Hashed Static Bundles: Cache immutably for speed
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 5. Local Fonts
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
